# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/spc_db
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@postgres:5432/spc_db

# ERP Database Configuration (for data synchronization)
ERP_DB_URL=  # e.g. "mssql+pyodbc://user:pass@host/erp_db?driver=ODBC+Driver+17+for+SQL+Server"
ERP_DB_SCHEMA=dbo
ERP_SYNC_BATCH_SIZE=500
ERP_SYNC_ENABLED=false

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# Application Configuration
SECRET_KEY=change-this-to-a-secure-random-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
API_PREFIX=/api/v1

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Cache Configuration
DASHBOARD_CACHE_TTL=300  # seconds

# File Storage Configuration
STORAGE_BACKEND=local           # local | s3
STORAGE_LOCAL_ROOT=/app/uploads
STORAGE_LOCAL_URL_PREFIX=/uploads
# S3 / MinIO (when STORAGE_BACKEND=s3, fill these)
# STORAGE_S3_ENDPOINT=
# STORAGE_S3_BUCKET=
# STORAGE_S3_ACCESS_KEY=
# STORAGE_S3_SECRET_KEY=
# STORAGE_S3_REGION=

# AI Service Configuration
AI_DEFAULT_PROVIDER=rule_based  # rule_based | openai | dashscope
AI_OPENAI_API_KEY=
AI_OPENAI_MODEL=gpt-4o-mini
AI_OPENAI_BASE_URL=
AI_DASHSCOPE_API_KEY=
AI_DASHSCOPE_MODEL=qwen-plus
AI_REQUEST_TIMEOUT=30
