# =====================================================================
# SPC-v2 环境配置模板 —— 主服务器（full 角色）/ 单机部署
# =====================================================================
# 使用方法：复制本文件为仓库根 .env，填写实际值。
#   本模板可安全提交；真实的 .env 含密码，永不进仓库（.gitignore 已排除）。
#
# 配置读取链路（重要，避免"改了不生效"）：
#   1) 后端 Settings（backend/app/core/config.py）按以下顺序加载 .env，后者覆盖前者：
#        仓库根 .env.local → 仓库根 .env → 当前目录 .env.local → 当前目录 .env
#   2) docker-compose*.yml 只把 environment 列表里显式声明的变量转发进容器；
#      未被转发的变量在容器内取「构建镜像时 COPY 进镜像的 backend/.env.local（如存在）」
#      或代码默认值 —— 本文件在对应位置标注【直连生效】。
#   3) POSTGRES_PASSWORD / REDIS_PASSWORD / MINIO_ROOT_USER / MINIO_ROOT_PASSWORD
#      只被 docker-compose-prod.yml 的 postgres / redis / minio 容器使用，应用本身不读。
#   4) 远程部署：scripts/deploy-remote.ps1 按 scripts/deploy-config.ps1 的 EnvFile
#      把本文件上传为远程 .env；改动后需重新部署或手工同步远程 .env。
# =====================================================================

# ==================== 1. 服务器实例标识 ====================
# 后端服务实例标识：写入 ERP 同步日志，多服务器部署时用于溯源是哪台机器执行的同步。
# 多台部署时每台必须唯一（如 spc-prod / spc-app1）；单机部署可随意。
SERVER_ID=Ubuntu-7o18

# ==================== 2. 数据库（PostgreSQL）====================
# 异步 / 同步两条连接串，指向同一个库（asyncpg 供应用、psycopg2 供 init_database 与 ERP 读取）。
# - docker-compose-prod.yml（full 角色）自带 postgres 容器：host 填服务名 postgres，
#   用户固定 root、库名固定 spc_db（见 compose 的 POSTGRES_USER/POSTGRES_DB），
#   密码必须与下方 POSTGRES_PASSWORD 一致；宿主机访问端口为 15432。
# - 本机直连运行时 host 填 localhost 或真实 DB 地址。
DATABASE_URL=postgresql+asyncpg://root:<数据库密码>@postgres:5432/spc_db
DATABASE_URL_SYNC=postgresql+psycopg2://root:<数据库密码>@postgres:5432/spc_db
# 连接池空闲连接回收秒数：远程 DB 的空闲连接会被防火墙/NAT 静默掐断（无 RST），
# 必须 recycle + pre_ping 双保险。【直连生效】compose 未转发，容器内取代码默认值 180。
DB_POOL_RECYCLE=180
# postgres 容器 root 用户的密码（仅 compose 的 postgres 服务使用，须与上面连接串一致）。
# 注意：该密码在首次启动时写入数据卷，之后改这里不会生效，需清空 ./data/postgres 重新初始化。
POSTGRES_PASSWORD=<换成强密码>

# ==================== 3. Redis ====================
# - full 角色 compose 自带 redis 容器并启用密码（见下方 REDIS_PASSWORD），URL 须带密码；
#   host 填服务名 redis，宿主机访问端口为 16379。
# - 本机直连/无密码时：redis://localhost:6379/0
REDIS_URL=redis://:<Redis密码>@redis:6379/0
# redis 容器 requirepass 密码（仅 compose 的 redis 服务使用）
REDIS_PASSWORD=<换成强密码>

# ==================== 4. 安全与认证（JWT / CORS）====================
# JWT 签名密钥：多服务器共库部署时，所有机器的 SECRET_KEY 必须完全一致，
# 否则跨实例签发的 token 校验失败。生产环境务必换成随机长字符串。
SECRET_KEY=<换成随机长字符串>
# 以下 4 项【直连生效】：compose 未转发，容器内取代码默认值（HS256 / 480 / /api/v1 / localhost:3000,5173），仅直连运行后端时生效。
# JWT 签名算法
ALGORITHM=HS256
# token 有效期（分钟，默认 8 小时）
ACCESS_TOKEN_EXPIRE_MINUTES=480
# API 路由前缀（前端 axios baseURL 依赖 /api/v1，一般不改）
API_PREFIX=/api/v1
# CORS 允许的前端来源，逗号分隔（dev 前端 3000/5173；nginx 同域反代时可不必改）
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ==================== 5. ERP 中间库同步（只读）====================
# ERP/K3 数据源连接串（Microsoft ODBC Driver 17 已内置在 backend 镜像）。
# 例：mssql+pyodbc://user:pass@host:1433/master?driver=ODBC+Driver+17+for+SQL+Server
# 老版本 SQL Server 若握手失败可追加 &TrustServerCertificate=yes&Encrypt=no
ERP_DB_URL=
# ERP 中间表所在 schema
ERP_DB_SCHEMA=dbo
# 总开关：false 不启动 ERP 同步后台任务。
# 多服务器部署时只允许主服务器开启（app 服务器必须 false），防止重复同步。
ERP_SYNC_ENABLED=false
# 每批同步条数
ERP_SYNC_BATCH_SIZE=500
# 单次 ERP 查询超时（秒），防止 SQL Server 慢查询无限挂起。【直连生效】compose 未转发，容器内取代码默认值 600。
ERP_SYNC_QUERY_TIMEOUT=600
# ERP 同步自动创建系统用户的默认密码（用户名取 ERP 员工号；首次登录强制改密）
ERP_SYNC_DEFAULT_PASSWORD=admin123
# K3 账套（链接服务器四段名前缀）：同步/读取（含盘点单导入预览、物料单位等）用 K3_DB，
# 回写用 K3_WRITE_DB（留空回落 K3_DB）。
# 测试验证期可保持同步读生产账套、只把回写指到测试账套，如：
#   K3_DB=k3sv.AIS20161019115614
#   K3_WRITE_DB=k3sv.AIS20240905142145
# 【注意】仅 docker-compose.yml(dev) 转发这两项；docker-compose-prod.yml 未转发，
# 容器内取镜像内置值/代码默认值（k3sv.AIS20161019115614）。
K3_DB=k3sv.AIS20161019115614
K3_WRITE_DB=

# ==================== 6. ERP 回写（写 K3）====================
# 回写目标账套连接串（通常与 ERP_DB_URL 同源同库，只是目标账套由 K3_WRITE_DB 决定）；
# 留空则回写复用 ERP_DB_URL。
ERP_DB_URL_WRITE=
# 回写 Worker 开关：多服务器部署时只应在一台服务器开启，多台同时开会重复回写
WRITEBACK_ENABLED=true
# Worker 轮询间隔（秒）
WRITEBACK_POLL_INTERVAL=5
# 每批处理条数
WRITEBACK_BATCH_SIZE=20
# 单条任务认领超时（秒）
WRITEBACK_CLAIM_TIMEOUT=120

# ==================== 7. 文件存储（上传 / 备份）====================
# 存储后端：local 本机磁盘 | s3 MinIO。
# 多服务器共享文件必须用 s3（所有机器读写同一 MinIO），否则各台只写本机磁盘、跨服务器访问上传文件 404。
STORAGE_BACKEND=local
# local 模式根目录（容器内路径；compose 已挂载 ./data/uploads 到此目录）
STORAGE_LOCAL_ROOT=/app/uploads
# local 模式对外访问 URL 前缀（nginx 反代 /uploads 用）。【直连生效】compose 未转发，容器内取代码默认值 /uploads。
STORAGE_LOCAL_URL_PREFIX=/uploads
# 单文件上传大小上限（字节，默认 100MB）。【直连生效】compose 未转发。
STORAGE_MAX_FILE_SIZE=104857600
# 备份目录（容器内路径；compose 已挂载 ./data/backups）。【直连生效】compose 未转发，容器内取代码默认值 /app/backups。
BACKUP_DIR=/app/backups
# ---- S3 / MinIO（STORAGE_BACKEND=s3 时生效；端点不含 http://，协议由 STORAGE_S3_SECURE 控制）----
# full 服务器填 minio:9000（compose 内部服务名）；app 服务器填 <主服务器内网IP>:19000
STORAGE_S3_ENDPOINT=
STORAGE_S3_BUCKET=spc-files
# 主服务器这两项留空即可（compose 自动复用 MINIO_ROOT_USER/PASSWORD）；
# app 服务器必须显式填写（值 = 主服务器的 MINIO_ROOT_USER / MINIO_ROOT_PASSWORD）
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
# 地域标识（MinIO 一般留空）
STORAGE_S3_REGION=
# 是否 HTTPS；MinIO 内网 http 保持 false
STORAGE_S3_SECURE=false
# MinIO 容器自身凭据（仅 docker-compose-prod.yml 的 minio 服务使用）
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=<换成强密码>

# ==================== 8. AI 助手 ====================
# 默认推理提供方：rule_based 规则引擎（无外部依赖）| openai（OpenAI 兼容 API）| dashscope（阿里云百炼）
AI_DEFAULT_PROVIDER=rule_based
# ---- OpenAI 兼容通道（用 DeepSeek / GLM 等国产模型时改 BASE_URL 与 MODEL）----
AI_OPENAI_API_KEY=
AI_OPENAI_MODEL=gpt-4o-mini
# 留空 = OpenAI 官方地址；国产模型示例：https://open.bigmodel.cn/api/v1
AI_OPENAI_BASE_URL=
# ---- 阿里云 DashScope ----
AI_DASHSCOPE_API_KEY=
AI_DASHSCOPE_MODEL=qwen-plus
# 单次 AI 请求超时（秒）
AI_REQUEST_TIMEOUT=30

# ==================== 9. Agent 稳固性（2026-07-10 引入）====================
# 本节全部【直连生效】：compose 未转发，容器内取镜像内置值；默认值如下。
# 长会话自动摘要开关
AI_SUMMARY_ENABLED=true
# 摘要触发阈值（token 数）
AI_SUMMARY_TOKEN_LIMIT=80000
# Agent 运行日志目录（空 = 默认 backend/logs/assistant）
AI_RUN_LOG_DIR=
# 日志保留天数
AI_LOG_RETENTION_DAYS=30
# Agent 单次执行总时长上限（秒）
AI_MAX_AGENT_DURATION_S=120

# ==================== 10. 企业微信（消息推送 / 审批通知）====================
# corp_id / 应用 agent_id / 应用 secret / 通讯录 secret。
# 全部留空则企微推送整体停用（审批超时提醒、工价缺口提醒等降级为只记日志）。
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_CORP_SECRET=
WECOM_CONTACT_SECRET=
# 本系统对外访问地址（企微消息内跳转链接、免登分享链接用），例如 https://spc.example.com
FRONTEND_BASE_URL=
# 数据供给预警的企微接收人 userid（逗号分隔）；留空则预警只记日志不推送。
#【直连生效】compose 未转发，容器内取镜像内置值。
DATA_SUPPLY_ALERT_WECOM_UIDS=

# ==================== 11. 缓存与业务参数 ====================
# UPPH 工时匹配口径：bom_code 按 BOM 编码匹配（当前唯一口径，一般不改）
UPPH_MATCH_MODE=bom_code
# 订单盘点建单/刷新 BOM 时，近 N 天内已盘过的（物料×仓库）行仅标记"近期已盘"免盘。
#【直连生效】compose 未转发，容器内取代码默认值 7。
STOCK_CHECK_RECENT_SKIP_DAYS=7
# 仪表盘缓存 TTL（秒）。【直连生效】compose 未转发，容器内取代码默认值 300。
DASHBOARD_CACHE_TTL=300
# ---- 订单工价缺口每日提醒（企微 textcard 推送）----
# 本节全部【直连生效】：compose 未转发，容器内取镜像内置值。注意该调度器每台后端实例都会启动，
# 多服务器部署时若镜像内置 enabled=true，会收到重复提醒。
# 提醒开关
WAGE_REMINDER_ENABLED=true
# 收件人系统用户名，逗号分隔（须已在系统中绑定 wecom_user_id）
WAGE_REMINDER_USERNAMES=chenqiaoxia
# 每日推送时刻（24 小时制，工作日推送，周末自动跳过）
WAGE_REMINDER_HOUR=8
WAGE_REMINDER_MINUTE=30

# ==================== 12. 执行面智能体（AEOS Hub 接入）====================
# 两个独立 Agent：查询（18 个只读端点）与推理（reasoning.analyze/cancel）。
# 启动：docker compose --profile aeos up -d
# 回退：docker compose --profile aeos-legacy up -d aeos-execution-agent
EXECUTION_WS_URL=
EXECUTION_PLANE_TOKEN=
EXECUTION_QUERY_AGENT_ID=runtime-control-platform-query
EXECUTION_REASONING_AGENT_ID=runtime-control-platform-reasoning
EXECUTION_QUERY_AGENT_NAME=公司中台查询智能体
EXECUTION_REASONING_AGENT_NAME=公司中台推理智能体
EXECUTION_SOURCE_SYSTEM=
EXECUTION_QUERY_AGENT_BASE_URL=http://aeos-query-agent:8790
EXECUTION_REASONING_AGENT_BASE_URL=http://aeos-reasoning-agent:8790
CONTROL_PLATFORM_BASE_URL=
CONTROL_PLATFORM_QUERY_APP_KEY=
CONTROL_PLATFORM_QUERY_APP_SECRET=
CONTROL_PLATFORM_REASONING_APP_KEY=
CONTROL_PLATFORM_REASONING_APP_SECRET=
EXECUTION_ORDER_AGENT_ID=runtime-control-platform-order
EXECUTION_ORDER_AGENT_NAME=公司中台订单智能体
EXECUTION_ORDER_AGENT_BASE_URL=http://aeos-order-agent:8790
CONTROL_PLATFORM_ORDER_APP_KEY=
CONTROL_PLATFORM_ORDER_APP_SECRET=
CONTROL_PLATFORM_TIMEOUT_MS=15000
CONTROL_PLATFORM_REASONING_TIMEOUT_MS=180000
AGENT_ADMIN_TOKEN=
# 旧 Agent 回退配置（验收后删除）
# 注意：dev 旧合并 Agent（aeos-execution-agent）与 prod 旧查询 Agent（execution-agent）
# 共用 EXECUTION_AGENT_ID 变量，但各 compose 服务默认值不同（runtime-control-platform-agent
# / runtime-execution-query）。回退时按实际使用的旧服务决定是否显式填写，未回退请留空。
EXECUTION_AGENT_ID=
EXECUTION_AGENT_BASE_URL=http://aeos-execution-agent:8790
CONTROL_PLATFORM_APP_KEY=
CONTROL_PLATFORM_APP_SECRET=
# AEOS Hub 助手观测上报（assistant-events）：智能助手每次对话把元数据+摘要上报 Hub「助手观测」。
# 三项均由 Hub 侧生成/提供（系统 ID 与 HMAC 令牌按系统绑定）；任一留空即整体停用上报
AEOS_HUB_BASE=
AEOS_SYSTEM_ID=
AEOS_SYSTEM_TOKEN=
# Hub 使用 Caddy 内部 CA 时指定 CA 证书路径（镜像内已内置 backend/certs/caddy-root.crt）
AEOS_HUB_CA_CERT=/app/certs/caddy-root.crt
# compose 为 backend 容器注入的 aeos-hub.test 解析地址（Hub 在局域网时使用）
AEOS_HUB_IP=192.168.0.23
