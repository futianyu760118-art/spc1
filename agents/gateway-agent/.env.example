# SPC 单一网关（gateway-control-platform）
EXECUTION_AGENT_KEY=gateway
EXECUTION_AGENT_ID=gateway-control-platform
EXECUTION_AGENT_NAME=公司中台系统网关
# 留空=本地模式（只提供 /admin/run 与 /internal/hub/*，不连 Hub）
EXECUTION_WS_URL=
# 系统令牌模式下可留空；仅 legacy 根令牌模式需要填写
EXECUTION_PLANE_TOKEN=
EXECUTION_SYSTEM_ID=control-platform
EXECUTION_SYSTEM_TOKEN=

AEOS_HUB_BASE=
AEOS_SYSTEM_ID=control-platform
AEOS_SYSTEM_TOKEN=
AEOS_HUB_CA_CERT=/app/certs/caddy-root.crt
NODE_EXTRA_CA_CERTS=/app/certs/caddy-root.crt

CONTROL_PLATFORM_BASE_URL=http://backend:8000/api/v1
BACKEND_INTERNAL_BASE_URL=http://backend:8000
CONTROL_PLATFORM_QUERY_APP_KEY=
CONTROL_PLATFORM_QUERY_APP_SECRET=
CONTROL_PLATFORM_REASONING_APP_KEY=
CONTROL_PLATFORM_REASONING_APP_SECRET=
CONTROL_PLATFORM_ORDER_APP_KEY=
CONTROL_PLATFORM_ORDER_APP_SECRET=
GATEWAY_INTERNAL_TOKEN=
AGENT_ADMIN_TOKEN=
CONTROL_PLATFORM_TIMEOUT_MS=15000
CONTROL_PLATFORM_REASONING_TIMEOUT_MS=180000
CONTROL_PLATFORM_ORDER_TIMEOUT_MS=15000
HEALTH_CHECK_PORT=8790
LOG_LEVEL=info
