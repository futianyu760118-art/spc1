# =====================================================================
# SPC-v2 纯应用服务器（app 角色）环境配置模板
# =====================================================================
# 使用方法：复制本文件为 .env.app1，填写实际值后在 scripts/deploy-config.ps1 的
# 服务器条目里设置 EnvFile = ".env.app1"。本模板可安全提交；真实的 .env.app1 含密码，永不进仓库。
#
# app 服务器不部署 postgres/redis/minio 镜像（docker-compose-app.yml），
# 数据库、Redis、MinIO 全部连接主服务器（Role=full 的那台）。
#
# 配置读取链路（重要，避免"改了不生效"）：
#   docker-compose-app.yml 只把 environment 列表里显式声明的变量转发进容器；
#   未被转发的变量在容器内取「构建镜像时 COPY 进镜像的 backend/.env.local（如存在）」
#   或代码默认值 —— 本文件在对应位置标注【直连生效】。
# =====================================================================

# ==================== 1. 服务器实例标识 ====================
# 每台唯一（记录在 ERP 同步日志中，用于溯源）。默认建议按服务器命名。
SERVER_ID=spc-app1

# ==================== 2. 数据库：指向主服务器的 postgres（端口 15432）====================
# 用户/密码/库名与主服务器 .env 的 DATABASE_URL 完全一致（用户 root、库 spc_db），
# 仅把主机改为主服务器 IP（compose 把 5432 映射到 15432，内网需放行）。
DATABASE_URL=postgresql+asyncpg://root:<数据库密码>@<主服务器IP>:15432/spc_db
DATABASE_URL_SYNC=postgresql+psycopg2://root:<数据库密码>@<主服务器IP>:15432/spc_db
# 连接池空闲连接回收秒数：跨服务器长连接同样会被防火墙/NAT 静默掐断，建议保持与主服务器一致。
#【直连生效】compose-app 未转发，容器内取镜像内置值/代码默认值 180。
DB_POOL_RECYCLE=180

# ==================== 3. Redis：指向主服务器的 redis（端口 16379）====================
# 密码与主服务器 .env 的 REDIS_PASSWORD 一致（compose 把 6379 映射到 16379，内网需放行）。
REDIS_URL=redis://:<Redis密码>@<主服务器IP>:16379/0

# ==================== 4. JWT 签名密钥：必须与主服务器 SECRET_KEY 完全一致 ====================
# 共库签发 JWT，不一致会导致跨实例 token 校验失败，请直接从主服务器 .env 复制。
SECRET_KEY=<从主服务器 .env 复制>
# 其余 JWT 相关项（ALGORITHM / ACCESS_TOKEN_EXPIRE_MINUTES / API_PREFIX / CORS_ORIGINS）
# compose-app 未转发，容器内取代码默认值——只要主服务器也没改这些，两边天然一致。

# ==================== 5. ERP 同步：app 服务器不跑（只允许主服务器跑，防止重复同步）====================
ERP_SYNC_ENABLED=false
ERP_DB_URL=
ERP_DB_SCHEMA=dbo
ERP_SYNC_BATCH_SIZE=500
# 自动创建用户的默认密码（用户名取 ERP 员工号）；app 服务器不跑同步，留空即可
ERP_SYNC_DEFAULT_PASSWORD=
# 单次 ERP 查询超时（秒）。app 服务器虽不跑同步，但盘点单导入预览等也会查 K3。
#【直连生效】compose-app 未转发，容器内取镜像内置值/代码默认值 600。
ERP_SYNC_QUERY_TIMEOUT=600
# K3 账套（同步读取 / 回写目标）。【注意】compose-app 未转发 K3_DB / K3_WRITE_DB，
# 容器内取镜像内置值（默认 k3sv.AIS20161019115614）。若主服务器改过账套，
# app 服务器会与其不一致——需同步改 compose-app 转发或镜像内置值，不要依赖下面两行。
# K3_DB=k3sv.AIS20161019115614
# K3_WRITE_DB=

# ==================== 6. ERP 回写：app 服务器不跑（回写 Worker 只应在一台服务器开启）====================
ERP_DB_URL_WRITE=
# 显式 false 而不是留空：compose-app 会转发此变量，空串会导致布尔解析失败、容器起不来
WRITEBACK_ENABLED=false
# 以下参数在 WRITEBACK_ENABLED=false 时不生效，保留默认值即可
WRITEBACK_POLL_INTERVAL=5
WRITEBACK_BATCH_SIZE=20
WRITEBACK_CLAIM_TIMEOUT=120

# ==================== 7. 文件存储：MinIO 对象存储（指向主服务器的 MinIO）====================
# 所有服务器的文件统一存主服务器 MinIO（主服务器 compose 发布 19000 端口，内网需放行），
# 否则各台 backend 只写本机磁盘，跨服务器访问上传文件会 404。
STORAGE_BACKEND=s3
STORAGE_S3_ENDPOINT=<主服务器IP>:19000
STORAGE_S3_BUCKET=spc-files
# 与主服务器 .env 的 MINIO_ROOT_USER / MINIO_ROOT_PASSWORD 一致
STORAGE_S3_ACCESS_KEY=<MinIO用户>
STORAGE_S3_SECRET_KEY=<MinIO密码>
STORAGE_S3_REGION=
# 内网 http 保持 false
STORAGE_S3_SECURE=false
# local 模式根目录（s3 模式下用不到，但 compose-app 挂载了 ./data/uploads 到此路径）
STORAGE_LOCAL_ROOT=/app/uploads
# 其余存储参数（STORAGE_LOCAL_URL_PREFIX / STORAGE_MAX_FILE_SIZE / BACKUP_DIR）
# compose-app 未转发，容器内取镜像内置值/代码默认值，一般无需配置。

# ==================== 8. AI 助手（如需启用，与主服务器保持一致）====================
# 每台服务器独立调 AI 接口，多台各自消耗配额；不用 AI 时保持 rule_based 即可。
AI_DEFAULT_PROVIDER=rule_based
AI_OPENAI_API_KEY=
AI_OPENAI_MODEL=gpt-4o-mini
AI_OPENAI_BASE_URL=
# 执行面推理专用模型（AEOS reason_control_platform）；留空沿用 AI_OPENAI_MODEL
# AEOS 联调建议 deepseek-flash（旧名 deepseek-v4-flash 亦可）
REASONING_MODEL=
AI_DASHSCOPE_API_KEY=
AI_DASHSCOPE_MODEL=qwen-plus
AI_REQUEST_TIMEOUT=30

# ==================== 9. Agent 稳固性（2026-07-10 引入）====================
# 本节全部【直连生效】：compose-app 未转发，容器内取镜像内置值。
# 需要与主服务器行为一致时改镜像内置值（backend/.env.local）而非本文件。
# AI_SUMMARY_ENABLED=true
# AI_SUMMARY_TOKEN_LIMIT=80000
# AI_RUN_LOG_DIR=
# AI_LOG_RETENTION_DAYS=30
# AI_MAX_AGENT_DURATION_S=120

# ==================== 10. 企业微信（如需启用，与主服务器保持一致）====================
# app 服务器同样会发企微推送（如审批超时提醒），凭据与主服务器相同即可。
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_CORP_SECRET=
WECOM_CONTACT_SECRET=
# 本台服务器的前端访问地址（企微消息里的链接跳转到本台，通常与主服务器不同）
FRONTEND_BASE_URL=https://<本台服务器域名或IP>:18084
# 数据供给预警企微接收人。【直连生效】compose-app 未转发，容器内取镜像内置值。
# DATA_SUPPLY_ALERT_WECOM_UIDS=

# ==================== 11. 业务参数 ====================
# UPPH 工时匹配口径：必须与主服务器一致（compose-app 会转发）
UPPH_MATCH_MODE=bom_code
# 以下全部【直连生效】：compose-app 未转发，容器内取镜像内置值/代码默认值。
# - STOCK_CHECK_RECENT_SKIP_DAYS（默认 7）：订单盘点"近期已盘"免盘天数，应与主服务器一致
# - DASHBOARD_CACHE_TTL（默认 300）：仪表盘缓存秒数
# - WAGE_REMINDER_*：工价缺口每日提醒。该调度器每台后端实例都会启动，
#   若镜像内置 enabled=true，多台服务器会重复推送提醒。
