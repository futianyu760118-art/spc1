# ===== SPC-v2 纯应用服务器（app）环境配置模板 =====
# 使用方法：复制本文件为 .env.app1，填写实际值后在 deploy-config.ps1 的服务器条目里
# 设置 EnvFile = ".env.app1"。本模板可提交；真实 .env.app1 含密码，永不进仓库。
# app 服务器不部署 postgres/redis 镜像，数据库与 Redis 均连接主服务器（Role=full 的那台）。

# 服务器实例标识（每台唯一，记录在 ERP 同步日志中）
SERVER_ID=spc-app1

# ===== 数据库：指向主服务器的 postgres（端口 15432）=====
# 用户/密码/库名与主服务器 .env 的 DATABASE_URL 完全一致，仅主机 IP 改为主服务器
DATABASE_URL=postgresql+asyncpg://root:<数据库密码>@<主服务器IP>:15432/spc_db
DATABASE_URL_SYNC=postgresql+psycopg2://root:<数据库密码>@<主服务器IP>:15432/spc_db

# ===== Redis：指向主服务器的 redis（端口 16379，密码同主服务器 REDIS_PASSWORD）=====
REDIS_URL=redis://:<Redis密码>@<主服务器IP>:16379/0

# ===== JWT 签名密钥：必须与主服务器 SECRET_KEY 完全一致 =====
# 共库签发 JWT，不一致会导致跨实例 token 校验失败，请直接从主服务器 .env 复制
SECRET_KEY=<从主服务器 .env 复制>

# ===== ERP 同步：app 服务器不跑（只允许主服务器跑，防止重复同步）=====
ERP_SYNC_ENABLED=false
ERP_DB_URL=
ERP_DB_SCHEMA=dbo
ERP_SYNC_BATCH_SIZE=500
ERP_SYNC_DEFAULT_PASSWORD=

# ===== 回写：app 服务器不跑（回写 Worker 只应在一台服务器开启）=====
ERP_DB_URL_WRITE=
WRITEBACK_ENABLED=
WRITEBACK_POLL_INTERVAL=
WRITEBACK_BATCH_SIZE=
WRITEBACK_CLAIM_TIMEOUT=

# ===== 文件存储 =====
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=/app/uploads

# ===== AI 服务（如需启用，与主服务器保持一致）=====
AI_DEFAULT_PROVIDER=rule_based
AI_OPENAI_API_KEY=
AI_OPENAI_MODEL=gpt-4o-mini
AI_OPENAI_BASE_URL=
AI_DASHSCOPE_API_KEY=
AI_DASHSCOPE_MODEL=qwen-plus
AI_REQUEST_TIMEOUT=30

UPPH_MATCH_MODE=bom_code

# ===== 企业微信（如需启用，与主服务器保持一致）=====
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_CORP_SECRET=
WECOM_CONTACT_SECRET=
# 本台服务器的前端访问地址（企业微信消息里的链接跳转用）
FRONTEND_BASE_URL=
