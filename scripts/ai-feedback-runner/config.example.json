{
  "base_url": "http://生产主机:18085",
  "username": "专用处理人账号（勿用个人账号，runner 登录会使其已登录会话失效）",
  "password": "该账号密码",
  "poll_interval_seconds": 10,
  "repo_dir": "D:/wanghuazheng/project/SPC-v2",
  "base_branch": "whz",
  "worktrees_dir": "D:/wanghuazheng/project/SPC-v2-ai-worktrees",
  "backend_python": "D:/software/miniconda3/python.exe",
  "gates": {
    "backend_command": "{python} -m pytest -q",
    "frontend_command": "npm run build",
    "timeout_minutes": 30
  },
  "claude": {
    "command": "claude",
    "dangerously_skip_permissions": false,
    "timeout_minutes": 60,
    "allowed_tools": [
      "Read", "Edit", "Write", "Glob", "Grep",
      "Bash(python -m pytest:*)", "Bash(py -m pytest:*)",
      "Bash(npm run build:*)", "Bash(npx tsc:*)",
      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)",
      "Bash(git show:*)", "Bash(git rev-parse:*)", "Bash(cd:*)", "Bash(ls:*)",
      "Bash(head:*)", "Bash(tail:*)", "Bash(cat:*)"
    ]
  },
  "blocked_globs": [
    ".env", ".env.*", "*.env", "**/.env", "**/.env.*", "**/*.env",
    "scripts/deploy-*", "**/scripts/deploy-*", "docker-compose-prod.yml"
  ]
}
