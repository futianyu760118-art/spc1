# 管理面（AEOS Hub）控制通道
EXECUTION_WS_URL=ws://127.0.0.1:8788/execution-agent
EXECUTION_PLANE_TOKEN=change-me
EXECUTION_AGENT_ID=runtime-execution-query
AGENT_NAME=execution-query-agent

# 查询子进程
PYTHON_BIN=python
# QUERY_SCRIPT=/绝对路径/company-control-query.py
# UPSTREAM_CLIENT_PATH=/绝对路径/mcp-company-control/mcp_server/upstream_client.py
QUERY_TIMEOUT_MS=30000

# 本地健康检查（0 关闭）
HEALTH_CHECK_PORT=8789
LOG_LEVEL=info

# 目标系统（中台 SPC）凭证 — 透传给查询子进程（HMAC 优先，契约 §4.1）
# CONTROL_PLATFORM_BASE_URL=http://127.0.0.1:8000/api/v1
# CONTROL_PLATFORM_APP_KEY=
# CONTROL_PLATFORM_APP_SECRET=
