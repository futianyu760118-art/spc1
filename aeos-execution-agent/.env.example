# AEOS Hub 执行面 WebSocket 地址（与 execution-agent 同一控制通道，值向管理面索取）
EXECUTION_WS_URL=ws://127.0.0.1:8788/execution-agent
# Hub 分配的执行面令牌（握手头 x-aeos-execution-token）
EXECUTION_PLANE_TOKEN=change-me
# 智能体 ID（Hub 侧分配；上线切流前勿与 execution-agent 的 runtime-execution-query 混用）
EXECUTION_AGENT_ID=spc-execution-agent
# 注册来源标识（Hub 仪表盘「来源」列，如 公司中控平台（UAT）；空=不下发）
EXECUTION_SOURCE_SYSTEM=
AGENT_NAME=aeos-execution-agent

# 中台（SPC）对外基地址，含 /api/v1 前缀（生产示例 http://150.158.13.110:18084/api/v1）
CONTROL_PLATFORM_BASE_URL=https://spc.hengyou-soft.com/api/v1
# 数据供给管理分配的 HMAC 凭据（须勾选 reasoning.* 与契约 §4.2 查询端点）
CONTROL_PLATFORM_APP_KEY=ak_xxx
CONTROL_PLATFORM_APP_SECRET=sk_xxx

# 查询超时（ms，与 mcp-company-control 默认一致）；推理超时 ≥ 中台 REASONING_TIMEOUT_S+60s
CONTROL_PLATFORM_TIMEOUT_MS=15000
CONTROL_PLATFORM_REASONING_TIMEOUT_MS=180000

# 本地健康检查端口（200=已注册在线；0 关闭；勿与 execution-agent 的 8789 冲突）
HEALTH_CHECK_PORT=8790
# 日志级别 debug|info|warn|error
LOG_LEVEL=info
