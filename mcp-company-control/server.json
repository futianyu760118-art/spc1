{
  "name": "company-control",
  "version": "0.2.0",
  "description": "公司智能控制中台只读业务能力（订单列表 / 订单明细列表 / BOM 多级树 / 健康检查）",
  "owner": "company-middle-platform",
  "transport": ["stdio", "streamable-http"],
  "read_only": true,
  "required_permissions": ["CONTROL_PLATFORM_READ"],
  "dependencies": [
    "中台 FastAPI 对外接口（/api/v1/external/*，数据供给 HMAC API Key）",
    "中台销售订单 / 订单明细 / BOM 数据源（只读）"
  ],
  "maintainer": "中台平台组（版本负责人待 Registry 提交时填写）",
  "runtime": "python>=3.12, mcp>=2.0",
  "tools": [
    { "name": "get_system_health", "permission_level": "READ_ONLY" },
    { "name": "orders_list", "permission_level": "READ_ONLY" },
    { "name": "order_details_list", "permission_level": "READ_ONLY" },
    { "name": "bom_tree", "permission_level": "READ_ONLY" }
  ]
}
